# API / database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL="postgresql://postgres:password@localhost:5432/raktkhoj"

# Donor response tokens. Generate a random secret of at least 32 characters.
DONOR_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Firebase Admin SDK (never expose these credentials to the browser)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Option A: path to a service-account JSON file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json
# Option B: put the full service-account JSON in FIREBASE_SERVICE_ACCOUNT_JSON instead.

# Server Ports
API_PORT=3002
CORS_ORIGIN=http://localhost:3000
