# RaktSetu Environment Configuration Template
# Copy to .env or individual app .env files for local development

# Database (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/raktkhoj"

# Ports
API_PORT=3002
PORT=3002
CORS_ORIGIN="http://localhost:3000,https://raktsetu-six.vercel.app"
PUBLIC_WEB_ORIGIN="http://localhost:3000"

# Donor Session Secret (Min 32 characters)
DONOR_SESSION_SECRET="your-32-char-random-donor-session-secret-here"

# Firebase Admin SDK (Optional for local development)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_SERVICE_ACCOUNT_JSON=

# Telegram Bot Integration (Donors only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=RaktKhojDonorBot
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_NOTIFICATIONS_ENABLED=false
